datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../../generated/tenant"
}

enum LocationStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TableStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MenuStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrderSource {
  CUSTOMER_TABLE
  STAFF_MANUAL
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELED
}