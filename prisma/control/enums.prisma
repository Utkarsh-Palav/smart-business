generator client {
  provider = "prisma-client"
  output   = "../../generated/control"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum TenantDatabaseProvider {
  NEON
}

enum TenantDatabaseStatus {
  PROVISIONING
  ACTIVE
  MIGRATION_REQUIRED
  SUSPENDED
  FAILED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
